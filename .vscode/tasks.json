{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Dev: Start frontend (localhost:5173)",
			"detail": "pnpm dev in frontend/ — uses frontend/.env (local Supabase 192.168.0.156:8080)",
			"type": "shell",
			"command": "pnpm",
			"args": ["dev"],
			"options": { "cwd": "${workspaceFolder}/frontend" },
			"isBackground": true,
			"group": { "kind": "build", "isDefault": true },
			"presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
			"problemMatcher": {
				"owner": "vite",
				"pattern": { "regexp": "^__never_matches__$" },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "VITE v",
					"endsPattern": "Local:\\s+http"
				}
			}
		},
		{
			"label": "Check: svelte-check (types)",
			"detail": "pnpm check in frontend/",
			"type": "shell",
			"command": "pnpm",
			"args": ["check"],
			"options": { "cwd": "${workspaceFolder}/frontend" },
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Test: vitest",
			"detail": "pnpm test --run in frontend/",
			"type": "shell",
			"command": "pnpm",
			"args": ["test", "--run"],
			"options": { "cwd": "${workspaceFolder}/frontend" },
			"group": { "kind": "test", "isDefault": true },
			"problemMatcher": []
		},
		{
			"label": "Build: production build (node adapter)",
			"detail": "Same build the deploy script makes, without deploying",
			"type": "shell",
			"command": "pnpm",
			"args": ["--filter", "aqura-frontend", "build"],
			"options": { "env": { "BUILD_ADAPTER": "node" } },
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Deploy: dry run (no commit, push or upload)",
			"detail": "deployment/push-and-deploy.cmd -DryRun",
			"type": "process",
			"command": "${workspaceFolder}/deployment/push-and-deploy.cmd",
			"args": ["-DryRun"],
			"problemMatcher": []
		},
		{
			"label": "Deploy: LOCAL server (bump version, push to Aqura-new, deploy 192.168.0.156)",
			"detail": "deployment/push-and-deploy.cmd — local server only; requires a clean working tree",
			"type": "process",
			"command": "${workspaceFolder}/deployment/push-and-deploy.cmd",
			"problemMatcher": []
		},
		{
			"label": "DB: open psql on LOCAL database",
			"detail": "ssh root@192.168.0.156 → psql as supabase_admin (local server only)",
			"type": "process",
			"command": "ssh",
			"args": ["-t", "root@192.168.0.156", "docker exec -it supabase-db psql -U supabase_admin -d postgres"],
			"presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
			"problemMatcher": []
		},
		{
			"label": "Server: LOCAL Supabase status",
			"detail": "Container status on 192.168.0.156",
			"type": "process",
			"command": "ssh",
			"args": ["root@192.168.0.156", "cd /supabase-server/docker/active && docker compose ps --format 'table {{.Name}}\t{{.Status}}'"],
			"problemMatcher": []
		}
	]
}
